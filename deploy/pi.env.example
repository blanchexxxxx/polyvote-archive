# 复制成 deploy/pi.env 再填自己的值。pi.env 已被 .gitignore 挡掉。
#
# 为什么单独拆一个文件而不是写死在 push.sh 里:
# 这些是你机器的坐标。写进代码就等于写进 git 历史,而历史是永久的 ——
# 库哪天翻公开,改写历史才能清掉。放这里,公开时零成本。

# 目标机器
POLYVOTE_PI=user@100.64.0.1

# SSH 私钥路径
POLYVOTE_KEY=$HOME/.ssh/id_ed25519

# 目标机器上的目录名 (相对 $HOME)
POLYVOTE_DEST=polyvote

# 观测台端口。注意别跟目标机器上已有的服务撞 ——
# 先 `ss -tln` 扫一眼,撞了会 OSError: Address already in use。
POLYVOTE_DASH_PORT=8920
