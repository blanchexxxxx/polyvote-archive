[Unit]
Description=polyvote 观测台 (只读 SQLite, 不碰交易逻辑)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/polyvote
# --host 0.0.0.0 是为了能从别的设备走 tailscale 看。观测台无鉴权,
# 所以这台机器必须在 tailscale/VPN 里 —— 公网机器请删掉 --host。
ExecStart=%h/polyvote/.venv/bin/python -u dashboard.py --host 0.0.0.0 --port 8920 --db %h/polyvote/polyvote.db
Restart=always
RestartSec=5
StandardOutput=append:%h/polyvote/dashboard.log
StandardError=append:%h/polyvote/dashboard.log

[Install]
WantedBy=default.target
